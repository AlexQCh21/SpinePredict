# Docker Compose lee este archivo (.env) automáticamente para interpolar variables.
# docker-compose.yml declara todas las variables requeridas; aquí se definen sus valores.
# Copia este archivo a .env y completa los valores reales. No subas .env al repositorio.

# Django (REQUERIDAS)
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=TU_IP_PUBLICA,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://TU_IP_PUBLICA:8000

# Base de datos Supabase Postgres (REQUERIDA)
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=1
DB_DISABLE_SERVER_SIDE_CURSORS=0

# Supabase Storage S3 compatible, bucket privado (opcional)
# Si se dejan vacías las credenciales/bucket, se usa almacenamiento local (solo útil sin Docker/prod).
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=
SUPABASE_MEDIA_EXPIRE=3600

# Modo demo compartido
DEMO_MODE=1
DEMO_CLEANUP_INTERVAL_SECONDS=3600
DEMO_ADMIN_USERNAME=demo_admin
DEMO_ADMIN_PASSWORD=Admin12345
DEMO_SPECIALIST_USERNAME=demo_especialista
DEMO_SPECIALIST_PASSWORD=Especialista12345

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
